{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/graph/**",
              "ui_kits/control-panel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Big Shoulders Display|IBM Plex Mono|IBM Plex Sans))/i]",
        "message": "Font not provided by the design system. Available: Big Shoulders Display, IBM Plex Mono, IBM Plex Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|active|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, active, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|accent|active|danger|ghost)$/]",
        "message": "<Button> variant must be one of 'default' | 'accent' | 'active' | 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfidenceBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|verified|width|showValue|key|ref|className|style|children)$/]",
        "message": "<ConfidenceBar> doesn't accept that prop. Declared props: value, verified, width, showValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='Counter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<Counter> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|category|confidence|verified|sources|key|ref|className|style|children)$/]",
        "message": "<EvidenceItem> doesn't accept that prop. Declared props: title, category, confidence, verified, sources."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kbd'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Kbd> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LegendRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|count|max|key|ref|className|style|children)$/]",
        "message": "<LegendRow> doesn't accept that prop. Declared props: type, count, max."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logomark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|lockup|size|descriptor|key|ref|className|style|children)$/]",
        "message": "<Logomark> doesn't accept that prop. Declared props: variant, lockup, size, descriptor."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logomark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark|mono)$/]",
        "message": "<Logomark> variant must be one of 'light' | 'dark' | 'mono'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|state|message|key|ref|className|style|children)$/]",
        "message": "<PhaseStep> doesn't accept that prop. Declared props: label, state, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhaseStep'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:pending|active|done|error)$/]",
        "message": "<PhaseStep> state must be one of 'pending' | 'active' | 'done' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Relation'] > JSXAttribute > JSXIdentifier[name!=/^(?:relation|count|key|ref|className|style|children)$/]",
        "message": "<Relation> doesn't accept that prop. Declared props: relation, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:aux|children|key|ref|className|style|children)$/]",
        "message": "<SectionTitle> doesn't accept that prop. Declared props: aux, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|action|onDismiss|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: kind, action, onDismiss, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:info|success|error)$/]",
        "message": "<Toast> kind must be one of 'info' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypeChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|drift|key|ref|className|style|children)$/]",
        "message": "<TypeChip> doesn't accept that prop. Declared props: type, drift."
      },
      {
        "selector": "JSXOpeningElement[name.name='TypeDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|color|key|ref|className|style|children)$/]",
        "message": "<TypeDot> doesn't accept that prop. Declared props: type, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='VerdictBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:coverage|note|children|key|ref|className|style|children)$/]",
        "message": "<VerdictBand> doesn't accept that prop. Declared props: coverage, note, children."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
